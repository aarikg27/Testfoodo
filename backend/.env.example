# Local development works with SQLite when DATABASE_URL is omitted.
# Neon example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./testfoodo.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_SCHEMA=true
SESSION_DAYS=30
SCRAPER_USER_AGENT=Testfoodo/1.0 (student nutrition project; contact: replace-with-your-email@example.com)
SCRAPER_CONCURRENCY=6

